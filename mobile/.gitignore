.pub/
/build/
!/mobile/build/

# Platform folders generated by `flutter create` — regenerate locally, don't
# commit device-specific/signing config from a machine that isn't the CI box.
# Uncomment once the platform folders exist and you've reviewed what's safe
# to check in (most Flutter projects DO commit android/ and ios/).
# android/
# ios/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
